@@ -0,0 +1,21 @@
+import Postbox
+import SwiftSignalKit
+
+// An eight-byte fork-specific key cannot collide with upstream's four-byte keys.
+let ayuPrivacySettingsKey: ValueBoxKey = {
+    let key = ValueBoxKey(length: 8)
+    key.setInt64(0, value: 0x4159555052495631)
+    return key
+}()
+
+func fetchAyuPrivacySettings(transaction: Transaction) -> AyuPrivacySettings {
+    return transaction.getPreferencesEntry(key: ayuPrivacySettingsKey)?.get(AyuPrivacySettings.self) ?? .default
+}
+
+func observeAyuPrivacySettings(postbox: Postbox) -> Signal<AyuPrivacySettings, NoError> {
+    return postbox.preferencesView(keys: [ayuPrivacySettingsKey])
+    |> map { view in
+        return view.values[ayuPrivacySettingsKey]?.get(AyuPrivacySettings.self) ?? .default
+    }
+    |> distinctUntilChanged
+}
