+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+
+private struct AyuSettingsArguments {
+    let update: (Int32, Bool) -> Void
+}
+
+private struct AyuSettingsEntry: ItemListNodeEntry {
+    let stableId: Int32
+    let title: String
+    let value: Bool?
+
+    var section: ItemListSectionId { return 0 }
+
+    static func < (lhs: AyuSettingsEntry, rhs: AyuSettingsEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        let arguments = arguments as! AyuSettingsArguments
+        if let value = self.value {
+            return ItemListSwitchItem(presentationData: presentationData, systemStyle: .glass, title: self.title, value: value, sectionId: self.section, style: .blocks, updated: { value in
+                arguments.update(self.stableId, value)
+            })
+        } else {
+            return ItemListTextItem(presentationData: presentationData, text: .plain(self.title), sectionId: self.section)
+        }
+    }
+}
+
+/// Local settings for the current account, available from Privacy and Security > Ayu.
+public func ayuSettingsController(context: AccountContext) -> ViewController {
+    let actions = DisposableSet()
+    let arguments = AyuSettingsArguments(update: { id, value in
+        actions.add(context.engine.privacy.updateAyuSettings { current in
+            var updated = current
+            switch id {
+            case 0: updated.hideOnline = value
+            case 1: updated.hideTyping = value
+            case 2: updated.keepChatsUnread = value
+            default: break
+            }
+            return updated
+        }.start())
+    })
+    let signal = combineLatest(context.sharedContext.presentationData, context.engine.privacy.ayuSettings())
+    |> deliverOnMainQueue
+    |> map { presentationData, settings -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        let entries: [AyuSettingsEntry] = [
+            AyuSettingsEntry(stableId: 0, title: "Не отправлять статус онлайн", value: settings.hideOnline),
+            AyuSettingsEntry(stableId: 1, title: "Скрывать набор текста и запись", value: settings.hideTyping),
+            AyuSettingsEntry(stableId: 2, title: "Не читать чаты автоматически", value: settings.keepChatsUnread),
+            AyuSettingsEntry(stableId: 3, title: "Настройки действуют только для этого аккаунта. Ручное прочтение и просмотры историй пока не скрываются. Отправка сообщений и другие действия могут раскрыть активность.", value: nil)
+        ]
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("Ayu · Приватность"), leftNavigationButton: nil, rightNavigationButton: nil, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false), arguments))
+    }
+    |> afterDisposed {
+        actions.dispose()
+    }
+    return ItemListController(context: context, state: signal)
+}
