@@ -0,0 +1,36 @@
+import Foundation
+
+/// Local, per-account preferences. They never change Telegram's server privacy settings.
+public struct AyuPrivacySettings: Codable, Equatable {
+    public var hideOnline: Bool
+    public var hideTyping: Bool
+    public var keepChatsUnread: Bool
+
+    public static let `default` = AyuPrivacySettings()
+
+    public init(hideOnline: Bool = false, hideTyping: Bool = false, keepChatsUnread: Bool = false) {
+        self.hideOnline = hideOnline
+        self.hideTyping = hideTyping
+        self.keepChatsUnread = keepChatsUnread
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case hideOnline, hideTyping, keepChatsUnread
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        self.hideOnline = try container.decodeIfPresent(Bool.self, forKey: .hideOnline) ?? false
+        self.hideTyping = try container.decodeIfPresent(Bool.self, forKey: .hideTyping) ?? false
+        self.keepChatsUnread = try container.decodeIfPresent(Bool.self, forKey: .keepChatsUnread) ?? false
+    }
+
+    public func shouldSendOnlinePresence(_ requested: Bool) -> Bool {
+        return requested && !self.hideOnline
+    }
+
+    public func shouldSendActivity(isCancellation: Bool, isGroupCall: Bool) -> Bool {
+        // Always allow cancellation of a previously published activity and call signaling.
+        return !self.hideTyping || isCancellation || isGroupCall
+    }
+}
