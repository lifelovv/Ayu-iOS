diff --git a/tools/ayu/tests/main.swift b/tools/ayu/tests/main.swift
new file mode 100644
--- /dev/null
+++ b/tools/ayu/tests/main.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+func check(_ value: @autoclosure () -> Bool, _ description: String) {
+    precondition(value(), description)
+}
+
+let empty = try JSONDecoder().decode(AyuPrivacySettings.self, from: Data("{}".utf8))
+check(empty == .default, "Missing preferences must preserve upstream behavior")
+let hidden = AyuPrivacySettings(hideOnline: true, hideTyping: true, keepChatsUnread: true)
+let encoded = try JSONEncoder().encode(hidden)
+let decoded = try JSONDecoder().decode(AyuPrivacySettings.self, from: encoded)
+check(decoded == hidden, "Preferences must survive a restart")
+let old = try JSONDecoder().decode(AyuPrivacySettings.self, from: Data("{\"hideOnline\":true}".utf8))
+check(old.hideOnline && !old.hideTyping && !old.keepChatsUnread, "New fields must have backward-compatible defaults")
+for requested in [false, true] {
+    check(AyuPrivacySettings.default.shouldSendOnlinePresence(requested) == requested, "Default presence must be unchanged")
+    check(!hidden.shouldSendOnlinePresence(requested), "Hidden presence must never advertise online")
+}
+check(!hidden.shouldSendActivity(isCancellation: false, isGroupCall: false), "Typing and recording must be suppressed")
+check(hidden.shouldSendActivity(isCancellation: true, isGroupCall: false), "Existing typing indicators must be cancellable")
+check(hidden.shouldSendActivity(isCancellation: false, isGroupCall: true), "Group calls must keep their speaking signaling")
+check(AyuPrivacySettings.default.shouldSendActivity(isCancellation: false, isGroupCall: false), "Default activity must be unchanged")
+print("Ayu privacy model tests passed")
