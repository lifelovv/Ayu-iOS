+import Foundation
+import Display
+import SwiftSignalKit
+import TelegramCore
+import TelegramPresentationData
+import ItemListUI
+import AccountContext
+
+private struct AyuHistoryEntry: ItemListNodeEntry {
+    let stableId: Int32
+    let text: String
+    var section: ItemListSectionId { return self.stableId }
+
+    static func < (lhs: AyuHistoryEntry, rhs: AyuHistoryEntry) -> Bool {
+        return lhs.stableId < rhs.stableId
+    }
+
+    func item(presentationData: ItemListPresentationData, arguments: Any) -> ListViewItem {
+        return ItemListTextItem(presentationData: presentationData, text: .plain(self.text), sectionId: self.section)
+    }
+}
+
+public func ayuMessageHistoryController(context: AccountContext) -> ViewController {
+    let actions = DisposableSet()
+    let formatter = DateFormatter()
+    formatter.dateStyle = .short
+    formatter.timeStyle = .short
+    let signal = combineLatest(context.sharedContext.presentationData, context.engine.privacy.ayuMessageHistory())
+    |> deliverOnMainQueue
+    |> map { presentationData, history -> (ItemListControllerState, (ItemListNodeState, Any)) in
+        var entries: [AyuHistoryEntry] = []
+        for (index, event) in history.entries.reversed().enumerated() {
+            let kind = event.kind == .edited ? "Изменено" : "Удалено"
+            let date = formatter.string(from: Date(timeIntervalSince1970: TimeInterval(event.timestamp)))
+            var text = "\(kind) · \(date)\nЧат: \(event.peerId) · Сообщение: \(event.messageId)\n\n\(event.text)"
+            if let updatedText = event.updatedText {
+                text += "\n\nПосле изменения:\n\(updatedText)"
+            }
+            entries.append(AyuHistoryEntry(stableId: Int32(index), text: text))
+        }
+        if entries.isEmpty {
+            entries.append(AyuHistoryEntry(stableId: 0, text: "Журнал пуст. Включите сохранение истории в настройках Ayu. Сообщения, которые клиент не получил, восстановить нельзя."))
+        }
+        let clearButton = ItemListNavigationButton(content: .text("Очистить"), style: .regular, enabled: !history.entries.isEmpty, action: {
+            actions.add(context.engine.privacy.clearAyuMessageHistory().start())
+        })
+        let state = ItemListControllerState(presentationData: ItemListPresentationData(presentationData), title: .text("История сообщений"), leftNavigationButton: nil, rightNavigationButton: clearButton, backNavigationButton: ItemListBackButton(title: presentationData.strings.Common_Back))
+        return (state, (ItemListNodeState(presentationData: ItemListPresentationData(presentationData), entries: entries, style: .blocks, animateChanges: false), ()))
+    }
+    |> afterDisposed {
+        actions.dispose()
+    }
+    return ItemListController(context: context, state: signal)
+}
