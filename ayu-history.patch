--- /dev/null
+++ b/submodules/TelegramCore/Sources/Settings/AyuMessageHistoryStorage.swift
@@ -0,0 +1,39 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+let ayuMessageHistoryKey: ValueBoxKey = {
+    let key = ValueBoxKey(length: 8)
+    key.setInt64(0, value: 0x4159554849535431)
+    return key
+}()
+
+func observeAyuMessageHistory(postbox: Postbox) -> Signal<AyuMessageHistory, NoError> {
+    return postbox.preferencesView(keys: [ayuMessageHistoryKey])
+    |> map { view in
+        return view.values[ayuMessageHistoryKey]?.get(AyuMessageHistory.self) ?? AyuMessageHistory()
+    }
+    |> distinctUntilChanged
+}
+
+func recordAyuMessageHistory(transaction: Transaction, ids: [MessageId], updatedText: String? = nil) {
+    guard fetchAyuPrivacySettings(transaction: transaction).saveMessageHistory else {
+        return
+    }
+    var history = transaction.getPreferencesEntry(key: ayuMessageHistoryKey)?.get(AyuMessageHistory.self) ?? AyuMessageHistory()
+    for id in ids {
+        guard id.namespace == Namespaces.Message.Cloud, id.peerId.namespace != Namespaces.Peer.SecretChat,
+              let message = transaction.getMessage(id), !message.text.isEmpty, !message.containsSecretMedia else {
+            continue
+        }
+        if let updatedText, updatedText == message.text {
+            continue
+        }
+        history.append(AyuMessageHistoryEntry(peerId: id.peerId.toInt64(), messageId: id.id,
+            kind: updatedText == nil ? .deleted : .edited, timestamp: Int64(Date().timeIntervalSince1970),
+            text: message.text, updatedText: updatedText))
+    }
+    transaction.updatePreferencesEntry(key: ayuMessageHistoryKey, { _ in
+        return PreferencesEntry(history)
+    })
+}
