@@ -0,0 +1,44 @@
+import Foundation
+
+public struct AyuMessageHistoryEntry: Codable, Equatable {
+    public enum Kind: String, Codable {
+        case edited
+        case deleted
+    }
+
+    public let peerId: Int64
+    public let messageId: Int32
+    public let kind: Kind
+    public let timestamp: Int64
+    public let text: String
+    public let updatedText: String?
+
+    public init(peerId: Int64, messageId: Int32, kind: Kind, timestamp: Int64, text: String, updatedText: String?) {
+        self.peerId = peerId
+        self.messageId = messageId
+        self.kind = kind
+        self.timestamp = timestamp
+        self.text = String(text.prefix(4096))
+        self.updatedText = updatedText.map { String($0.prefix(4096)) }
+    }
+}
+
+/// Text snapshots only. Stored inside the account's Postbox, never uploaded.
+public struct AyuMessageHistory: Codable, Equatable {
+    public private(set) var entries: [AyuMessageHistoryEntry] = []
+
+    public init() {
+    }
+
+    public mutating func append(_ entry: AyuMessageHistoryEntry) {
+        if let previous = self.entries.last, previous.peerId == entry.peerId,
+           previous.messageId == entry.messageId, previous.kind == entry.kind,
+           previous.text == entry.text, previous.updatedText == entry.updatedText {
+            return
+        }
+        self.entries.append(entry)
+        if self.entries.count > 500 {
+            self.entries.removeFirst(self.entries.count - 500)
+        }
+    }
+}
diff --git a/submodules/TelegramCore/Sources/Settings/AyuMessageHistoryStorage.swift b/submodules/TelegramCore/Sources/Settings/AyuMessageHistoryStorage.swift
